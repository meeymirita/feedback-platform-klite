generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS собирается в CommonJS (в package.json нет "type": "module")
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: URL больше не задаётся в схеме.
  //  • CLI (migrate / db push) берёт datasource.url из prisma.config.ts
  //  • рантайм — new PrismaClient({ adapter }) c @prisma/adapter-pg
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  displayName String
  role        UserRole @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  MIRA
}
