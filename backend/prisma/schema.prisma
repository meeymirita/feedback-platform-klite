generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // NestJS собирается в CommonJS (в package.json нет "type": "module")
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: URL больше не задаётся в схеме.
  //  • CLI (migrate / db push) берёт datasource.url из prisma.config.ts
  //  • рантайм — new PrismaClient({ adapter }) c @prisma/adapter-pg
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  displayName String
  role        UserRole @default(USER)

  entries ReportEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  MIRA
}

// Одна задача сотрудника за день. Неделя/суммы считаются из выборки, отдельной
// таблицы недельного отчёта нет.
model ReportEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  domain      String
  link        String   @default("")
  description String
  minutes     Int // время на задачу в минутах

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, date])
  @@map("report_entries")
}
