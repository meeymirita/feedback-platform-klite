# Переменные для запуска backend НАПРЯМУЮ на хосте (npm run start:dev).
# Скопировать в backend/.env и заполнить. backend/.env в git не коммитится.
# Хосты — localhost: Postgres и Redis поднимаются в Docker и проброшены на хост
# (см. корневой docker-compose.yml). В самом Docker-контейнере backend'а эти же
# переменные приходят из docker-compose.yml (там хосты — postgres / redis).
#
# ${...} раскрываются: @nestjs/config с expandVariables:true и prisma.config.ts
# через dotenv-expand.

NODE_ENV="development"

APPLICATION_PORT=3000
APPLICATION_URL="http://localhost:${APPLICATION_PORT}"
ALLOWED_ORIGIN="https://meeymirita.localhost:8443"

COOKIES_SECRET=replace_with_long_random_string

# Сессия (express-session + connect-redis)
SESSION_SECRET=replace_with_long_random_string
SESSION_NAME="klite.sid"
SESSION_DOMAIN=""          # пусто в dev → host-only кука; в проде — боевой домен
SESSION_MAX_AGE="30d"
SESSION_HTTP_ONLY=true
SESSION_SECURE=false       # прод: true (только по HTTPS, нужен trust proxy)
SESSION_FOLDER="sessions:"

# Сид суперпользователя: npm run seed. Роль всегда MIRA, он в системе один.
SEED_MIRA_EMAIL=""
SEED_MIRA_PASSWORD=""
SEED_MIRA_NAME="mira"

POSTGRES_USER="root"
POSTGRES_PASSWORD="change_me"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="full-authorization"
POSTGRES_URI="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

REDIS_USER="default"
REDIS_PASSWORD="change_me"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URI="redis://${REDIS_USER}:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"
