# ─────────────────────────────────────────────────────────────
# Корневой .env — читается ТОЛЬКО docker compose (подстановка ${...}
# в docker-compose.yml). Скопировать и заполнить:  cp .env.example .env
#
# Секреты генерировать:  openssl rand -hex 32
# Приложение backend в Docker берёт переменные из блока environment:
# сервиса backend (который и подставляет сюда эти значения).
#
# ВАЖНО: комментарии — только на отдельной строке (как здесь).
# Хвостовой «VALUE  # текст» docker compose для пустого значения
# затягивает в саму переменную (был баг с SESSION_DOMAIN).
# ─────────────────────────────────────────────────────────────

# ── Точка входа (Caddy, HTTPS автоматически по Let's Encrypt) ─
SITE_ADDRESS=meeymirita.ru
ALLOWED_ORIGIN=https://meeymirita.ru
# 80/443 обязательны: Caddy проходит ACME-челлендж
HTTP_PORT=80
HTTPS_PORT=443

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=klite
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=klite
# публикуется только на 127.0.0.1
POSTGRES_PORT=5433

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=production
APPLICATION_PORT=3000
COOKIES_SECRET=CHANGE_ME_long_random
SESSION_SECRET=CHANGE_ME_long_random
SESSION_NAME=klite.sid
# пусто → host-only кука (ок для одного домена). Оставлять именно пустым.
SESSION_DOMAIN=
SESSION_MAX_AGE=30d
SESSION_HTTP_ONLY=true
# прод по HTTPS → обязательно true
SESSION_SECURE=true
SESSION_FOLDER=sessions:

# ── Суперпользователь MIRA (создаётся сервисом migrate) ──────
SEED_MIRA_EMAIL=meeymirita@yandex.ru
SEED_MIRA_PASSWORD=CHANGE_ME
SEED_MIRA_NAME=mira

# ── Прочее ───────────────────────────────────────────────────
TZ=Europe/Moscow
