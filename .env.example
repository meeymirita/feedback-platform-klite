# ─────────────────────────────────────────────────────────────
# Пример переменных окружения. Скопировать в .env и заполнить:
#     cp .env.example .env
# Файл .env в git не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=reports
POSTGRES_USER=mira
POSTGRES_PASSWORD=change_me_in_prod
# Порт, на котором БД видна с хоста (внутри сети compose всегда 5432)
POSTGRES_PORT=5432

# ── Backend (NestJS) ─────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=3000
# Строка подключения для TypeORM/Prisma. Хост = имя сервиса compose.
DATABASE_URL=postgresql://mira:change_me_in_prod@postgres:5432/reports

# JWT
JWT_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Точка входа (Caddy, HTTPS автоматически) ─────────────────
# SITE_ADDRESS — это ХОСТ, по которому открывается сайт, а не имя/бренд.
# Допустимо ТОЛЬКО одно из:
#   localhost              → внутренний CA Caddy (локально)
#   что-то.localhost       → внутренний CA + имя в URL (напр. meeymirita.localhost);
#                            Chrome/Firefox резолвят сами, Safari — через /etc/hosts
#   192.168.x.x            → внутренний CA по IP
#   reports.company.ru     → настоящий публичный домен → Let's Encrypt/ZeroSSL по ACME
# Голое слово без точки (напр. "meeymirita") НЕ РАБОТАЕТ: Caddy уйдёт в Let's Encrypt
# и получит отказ "Domain name needs at least one dot".
SITE_ADDRESS=localhost
HTTP_PORT=8080    # HTTP: редирект на HTTPS + ACME
HTTPS_PORT=8443   # HTTPS: на нём открывается приложение

# ── Прочее ───────────────────────────────────────────────────
TZ=Europe/Moscow
