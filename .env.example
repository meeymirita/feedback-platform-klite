# ─────────────────────────────────────────────────────────────
# Корневой .env — читается ТОЛЬКО docker compose (подстановка ${...}
# в docker-compose.yml). Скопировать в .env и заполнить:
#     cp .env.example .env
#
# Приложение backend свои переменные берёт:
#   • dev (npm run start:dev на хосте) → backend/.env  (см. backend/.env.example)
#   • Docker                            → блок environment: сервиса backend
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me
POSTGRES_DB=full-authorization
POSTGRES_PORT=5433          # порт на хосте; внутри сети compose всегда 5432

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_me
REDIS_PORT=6379

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=production
APPLICATION_PORT=3000
ALLOWED_ORIGIN=https://meeymirita.localhost:8443
COOKIES_SECRET=replace_with_long_random_string

# ── Точка входа (Caddy, HTTPS автоматически) ─────────────────
# SITE_ADDRESS — ХОСТ сайта: localhost / *.localhost / IP / реальный домен с точкой.
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# ── Прочее ───────────────────────────────────────────────────
TZ=Europe/Moscow
