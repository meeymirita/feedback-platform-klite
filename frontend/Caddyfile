# Caddyfile — продакшн. Отдаёт собранный SPA и проксирует API.
# HTTPS включается автоматически по значению SITE_ADDRESS (приходит из окружения,
# см. .env / docker-compose.yml). SITE_ADDRESS — это ХОСТ сайта, не имя проекта:
#   • localhost / *.localhost / IP → локальный внутренний CA Caddy;
#   • reports.company.ru (домен с точкой, резолвится) → Let's Encrypt/ZeroSSL по ACME.
# Голое слово без точки уходит в Let's Encrypt и падает ("needs at least one dot").

{$SITE_ADDRESS:localhost} {
	# Сжатие ответов (zstd для поддерживающих, иначе gzip)
	encode zstd gzip

	# /api/* → backend:3000, префикс /api снимается handle_path'ом:
	#   /api/auth/login → GET http://backend:3000/auth/login
	handle_path /api/* {
		reverse_proxy backend:3000
	}

	# SPA: есть файл — отдаём его, нет — index.html (history-режим vue-router)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Хэшированные ассеты Vite (/assets/app.[hash].js) — кэш на год
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Логи в stdout в человекочитаемом виде (собираются docker logs)
	log {
		output stdout
		format console
	}
}
